# Deployment template only; not loaded automatically by Spring Boot.
# Enable the public issuer ONLY after DNS, TLS and the Keycloak route work on the host.
# This assumes Keycloak is served at https://sunnytech.cloud/realms/jhipster.
# If Keycloak uses a separate domain, replace both issuer values with its actual issuer.
SPRING_PROFILES_ACTIVE=prod
APP_OIDC_ISSUER=https://sunnytech.cloud/realms/jhipster
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_ISSUER_URI=https://sunnytech.cloud/realms/jhipster
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_ID=web_app
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_SECRET=REPLACE_WITH_HOST_SECRET
RBAC_KEYCLOAK_ISSUER_URI=http://keycloak:9080/realms/jhipster
RBAC_KEYCLOAK_CLIENT_ID=rbac-admin
RBAC_KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_HOST_SECRET
SERVER_FORWARD_HEADERS_STRATEGY=framework
