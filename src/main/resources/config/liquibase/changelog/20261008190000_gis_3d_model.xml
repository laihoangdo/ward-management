        <insert tableName="gis_building_type"><column name="code" value="two"/><column name="name" value="Nhà 2 tầng"/><column name="default_height_m" valueNumeric="7"/><column name="color" value="#68b884"/><column name="floor_count" valueNumeric="2"/></insert>
        <insert tableName="gis_building_type"><column name="code" value="three"/><column name="name" value="Nhà 3 tầng"/><column name="default_height_m" valueNumeric="10"/><column name="color" value="#eea25c"/><column name="floor_count" valueNumeric="3"/></insert>
        <insert tableName="gis_building_type"><column name="code" value="four"/><column name="name" value="Nhà 4 tầng"/><column name="default_height_m" valueNumeric="13"/><column name="color" value="#dc7770"/><column name="floor_count" valueNumeric="4"/></insert>
        <insert tableName="gis_building_type"><column name="code" value="fivePlus"/><column name="name" value="Nhà 5+ tầng"/><column name="default_height_m" valueNumeric="17"/><column name="color" value="#c46570"/><column name="floor_count" valueNumeric="5"/></insert>
        <insert tableName="gis_building_type"><column name="code" value="large"/><column name="name" value="Tòa nhà lớn"/><column name="default_height_m" valueNumeric="22"/><column name="color" value="#9c82bd"/><column name="floor_count" valueNumeric="6"/></insert>
    </changeSet>
</databaseChangeLog>
