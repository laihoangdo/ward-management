[Unit]
Description=Minimized police RBAC audit and operations heartbeat to Cloud Logging
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/police-management/staging/export-cloud-audit.py
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/police-management /etc/police-management/secrets/staging
